# Mock mode (default): no backend needed.
VITE_USE_MOCK=true

# API mode. In `npm run dev` the relative default /api/v1 is proxied to http://127.0.0.1:5000.
# A production build with VITE_USE_MOCK=false REQUIRES VITE_API_BASE_URL (the build fails without it).
# VITE_USE_MOCK=false
# VITE_API_BASE_URL=https://<api-host>/api/v1
# VITE_API_TIMEOUT_MS=60000   # default 10000; raise for hosts that cold-start
