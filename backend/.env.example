# Local development. Copy to .env (never commit .env).
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///app.db
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_TOKEN_MINUTES=15

# --- staging / production (e.g. Render); see DEPLOYMENT.md ---
# FLASK_ENV=staging                      # or production (no demo data)
# DATABASE_URL=postgresql://user:pass@host:5432/db
# SECRET_KEY=<random, >= 32 chars>
# JWT_SECRET_KEY=<different random, >= 32 chars>
# CORS_ORIGINS=https://<frontend-host>   # comma-separated, https only, no '*'
# PROXY_FIX_HOPS=1                        # proxies in front of the app (default 1 in staging/production)
# SEED_DEMO_DATA=true                     # staging only: load the synthetic demo data on start
# SEED_DEMO_PASSWORD=<demo account password>

# --- email (patient contact email: verification + notification emails); see backend/README.md ---
# EMAIL_PROVIDER=capture                  # development default: messages kept in memory / EMAIL_CAPTURE_DIR, nothing sent
# EMAIL_CAPTURE_DIR=instance/email-outbox # development only (git-ignored)
# APP_BASE_URL=http://localhost:5173     # web app address used in email links
# staging / production: EMAIL_PROVIDER unset = disabled (nothing is sent). A real provider is not
# implemented yet; once chosen, set these in the Render dashboard (never in this file or render.yaml):
# EMAIL_PROVIDER=<provider>
# EMAIL_API_KEY=<secret>
# EMAIL_FROM=<sender address>
# EMAIL_FROM_NAME=化療照護
# EMAIL_TIMEOUT_SECONDS=10
